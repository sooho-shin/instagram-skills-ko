    {"id": "ko-not-just", "regex": "(?:단순히|단순한|그저|그냥)[^.!?\\n]{1,40}(?:아니라|아닌)", "name": "\"단순히 X가 아니라 Y\"", "fix": "말하려는 Y만 쓰고 앞의 X는 지우기."},
    {"id": "ko-not-only", "regex": "뿐만 아니라", "name": "\"X뿐만 아니라 Y\"", "fix": "두 문장으로 나누거나 약한 쪽을 빼기."},
    {"id": "ko-preview", "regex": "(?:알아보겠습니다|알아볼게요|알아볼까요|살펴보겠습니다|살펴볼게요|소개해 ?드리겠습니다|소개해 ?드릴게요|이야기해 ?볼게요)", "name": "예고 문장 (\"~에 대해 알아볼게요\")", "fix": "예고하지 말고 첫 문장에서 바로 그 내용을 말하기."},
    {"id": "ko-greeting", "regex": "(?m)^\\s*안녕하세요", "name": "인사로 시작", "fix": "첫 줄은 피드에서 보이는 유일한 줄. 인사 대신 훅으로."},
    {"id": "ko-in-summary", "regex": "(?m)^\\s*(?:결론적으로|요약하자면|정리하자면|종합하면|종합적으로|마무리하며)", "name": "요약 문단 시작어", "fix": "캡션에 결론 문단은 필요 없음. 마지막 줄을 하나의 요청으로."},
    {"id": "ko-worry-question", "regex": "(?:고민이신가요|궁금하신가요|고민하고 계신가요|고민되시나요|어려우신가요|고민 중이신가요)\\?", "name": "\"~고민이신가요?\" 질문 훅", "fix": "광고 문구 훅. 실제 상황이나 숫자로 시작하기 (예: '아침 7도, 반팔 입고 나갔다가')."},
    {"id": "ko-triad", "regex": "[가-힣A-Za-z]+, [가-힣A-Za-z]+, 그리고 [가-힣A-Za-z]+", "name": "\"A, B, 그리고 C\" 세 개 나열", "fix": "'그리고'를 마지막 항목 앞에 두는 건 영어 번역투. 둘로 줄이거나 '~랑 ~'으로."},
    {"id": "ko-follow-bait", "regex": "(?:팔로우하고 더 보기|좋아요와 팔로우|좋아요 ?& ?팔로우|친구를 태그해|공감하시면 좋아요)", "name": "반사적 참여 유도", "fix": "요청은 하나만, 이 게시물에 맞는 걸로."}
